{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "test", "firebase-debug.log", "*.local", "*.log"]
    }
  ],
  "emulators": {
    "auth": { "host": "127.0.0.1", "port": 9099 },
    "firestore": { "host": "127.0.0.1", "port": 8086 },
    "functions": { "host": "127.0.0.1", "port": 5001 },
    "ui": { "enabled": false }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // The progress document may hold exactly these fields, with these
    // types. Anything else (entitlements, flags, extra data) is refused;
    // purchases will live in a document only the server writes.
    // `data` is the document as it would be after the write, so this also
    // covers merge writes that touch only some of the fields.
    function isValidProgress(data) {
      return data.keys().hasOnly(
              ['track', 'completedLessons', 'dailyXp', 'updatedAt'])
          && (!('track' in data) || data.track in ['starter', 'fast'])
          && (!('completedLessons' in data)
              || (data.completedLessons is list
                  // Far above the course size, low enough to stop abuse.
                  // Rules can't loop over a list, so element types are
                  // checked by the app when it reads the document.
                  && data.completedLessons.size() <= 1000))
          // XP per day: a map from a `yyyy-MM-dd` day to a number. The size
          // limit (about 11 years of days) stops abuse; rules can't loop
          // over a map, so the app checks keys and values when it reads.
          && (!('dailyXp' in data)
              || (data.dailyXp is map && data.dailyXp.size() <= 4000))
          // Every write the app makes sets updatedAt to the server time.
          && data.updatedAt is timestamp
          && data.updatedAt == request.time;
    }

    // When an account is deleted, the Cloud Function in functions/ writes
    // deletedUsers/{uid}. A device that is still signed in keeps a valid ID
    // token for up to an hour, so without this check its next sync would
    // recreate users/{uid} for an account that no longer exists. Clients
    // can't touch deletedUsers (the catch-all below closes it; the Admin
    // SDK bypasses rules). A new account gets a new random UID, so a
    // tombstone never blocks a real new account.
    function isNotDeleted(uid) {
      return !exists(/databases/$(database)/documents/deletedUsers/$(uid));
    }

    // Each learner can read and write only their own progress document.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && isNotDeleted(uid)
          && isValidProgress(request.resource.data);
      // In-app account deletion removes the document.
      allow delete: if isOwner(uid);
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

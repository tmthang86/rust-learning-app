{
    "default-runtime": "runsc",
    "icc": false,
    "live-restore": false,
    "log-driver": "local",
    "log-opts": {
        "max-file": "3",
        "max-size": "10m"
    },
    "no-new-privileges": true,
    "runtimes": {
        "runsc": {
            "path": "/usr/bin/runsc"
        }
    },
    "userland-proxy": false
}
# Managed by rust-runner install.sh. Edits here are overwritten on the next
# deploy. Rendered from runner/deploy/Caddyfile.template.
{
	{{ACME_CA_LINE}}
	servers {
		timeouts {
			read_header 10s
			read_body 20s
			write 60s
			idle 120s
		}
		max_header_size 16KB
		protocols h1 h2
	}
}

{{RUNNER_DOMAIN}} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}

	@runner path /run /grade /health
	handle @runner {
		request_body {
			max_size 256KB
		}
		reverse_proxy 127.0.0.1:8080 {
			transport http {
				dial_timeout 2s
				response_header_timeout 50s
			}
		}
	}

	handle {
		respond 404
	}
}

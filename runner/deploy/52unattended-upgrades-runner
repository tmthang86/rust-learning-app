// Installed as /etc/apt/apt.conf.d/52unattended-upgrades-runner
// Ubuntu security updates (the default origins in 50unattended-upgrades)
// plus Caddy from its own repository. Caddy faces the internet and often
// ships patch releases; upgrading it restarts it for about a second.
// Docker, containerd and runsc are pinned and held: they are only changed by
// `push.sh --upgrade-packages`.
Unattended-Upgrade::Origins-Pattern {
	"site=dl.cloudsmith.io";
};
// /etc/caddy/Caddyfile is ours; keep it on upgrade instead of stopping at a
// conffile prompt (which would make unattended-upgrades skip Caddy forever).
Dpkg::Options {
	"--force-confdef";
	"--force-confold";
};
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
Unattended-Upgrade::Automatic-Reboot "true";
// The VM clock is UTC. 20:00 UTC is 03:00 in Vietnam (UTC+7).
Unattended-Upgrade::Automatic-Reboot-Time "20:00";
